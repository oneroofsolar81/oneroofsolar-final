<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  Redirect 301 /residential-solar-system /solar-systems/residential-solar-system
  Redirect 301 /residential-solar-system/ /solar-systems/residential-solar-system
  Redirect 301 /services/residential-solar-system /solar-systems/residential-solar-system
  Redirect 301 /services/residential-solar-system/ /solar-systems/residential-solar-system
  Redirect 301 /services/commercial-solar-system /solar-systems/commercial-solar-system
  Redirect 301 /services/commercial-solar-system/ /solar-systems/commercial-solar-system
  Redirect 301 /commercial-solar-system /solar-systems/commercial-solar-system
  Redirect 301 /commercial-solar-system/ /solar-systems/commercial-solar-system
  Redirect 301 /services/off-grid-solar-system /solar-systems/off-grid-solar-system
  Redirect 301 /services/off-grid-solar-system/ /solar-systems/off-grid-solar-system
  Redirect 301 /off-grid-solar-system /solar-systems/off-grid-solar-system
  Redirect 301 /off-grid-solar-system/ /solar-systems/off-grid-solar-system
  Redirect 301 /services/solar-panel/ /solar-panels-darwin/
  Redirect 301 /services/solar-panel /solar-panels-darwin/
  Redirect 301 /services/repairs-and-maintenance/ /solar-panels-darwin/
  Redirect 301 /services/repairs-and-maintenance /solar-panels-darwin/
  Redirect 301 /repairs-and-maintenance /solar-panels-darwin/
  Redirect 301 /repairs-and-maintenance/ /solar-panels-darwin/
  Redirect 301 /solar-panel-installation-darwin /services/solar-panel-installation
  Redirect 301 /solar-panel-installation-darwin/ /services/solar-panel-installation
  Redirect 301 /solar-panel-installation /services/solar-panel-installation
  Redirect 301 /solar-panel-installation/ /services/solar-panel-installation
  Redirect 301 /solar-inverters /products/solar-inverters
  Redirect 301 /solar-inverters/ /products/solar-inverters
  Redirect 301 /services/battery-storage /products/solar-battery-brands/
  Redirect 301 /services/battery-storage/ /products/solar-battery-brands/
  Redirect 301 /battery-storage /products/solar-battery-brands/
  Redirect 301 /battery-storage/ /products/solar-battery-brands/
  Redirect 301 /solar-battery /products/solar-battery-brands/
  Redirect 301 /solar-battery/ /products/solar-battery-brands/
  Redirect 301 /solar-battery-storage /products/solar-battery-brands/
  Redirect 301 /solar-battery-storage/ /products/solar-battery-brands/
  Redirect 301 /services/ev-chargers /services/ev-chargers/installation
  Redirect 301 /services/ev-chargers/ /services/ev-chargers/installation
  Redirect 301 /ev-charger /services/ev-chargers/installation
  Redirect 301 /ev-charger/ /services/ev-chargers/installation
  Redirect 301 /ev-chargers /services/ev-chargers/installation
  Redirect 301 /ev-chargers/ /services/ev-chargers/installation
  Redirect 301 /blog /blogs
  Redirect 301 /blog/ /blogs
  Redirect 301 /alice-springs /solar-alice-springs/
  Redirect 301 /alice-springs/ /solar-alice-springs/
  Redirect 301 /solar-power-alice-springs-nt /solar-alice-springs/
  Redirect 301 /solar-power-alice-springs-nt/ /solar-alice-springs/

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ==========================================================================
# Compression — shrink text payloads (HTML/CSS/JS/JSON/SVG/fonts) in transit.
# Brotli is used when available, otherwise gzip.
# ==========================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/rss+xml application/vnd.ms-fontobject font/ttf font/otf font/woff font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/rss+xml application/vnd.ms-fontobject font/ttf font/otf font/woff font/woff2
</IfModule>

# ==========================================================================
# Caching — hashed build assets never change, so cache them for a year.
# HTML is revalidated so deploys go live immediately.
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed, immutable build output (JS/CSS carry a content hash in the filename)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Images, fonts, icons
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # HTML and data: always revalidate so new deploys are seen right away
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Mark fingerprinted assets as immutable so browsers skip revalidation
  <FilesMatch "\.(js|css|woff2|woff|webp|avif|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Keep HTML fresh so the SPA shell and prerendered pages update on deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
