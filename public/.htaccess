<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  Redirect 301 /services/repairs-and-maintenance/ /services/solar-panel-maintenance-darwin/
  Redirect 301 /services/repairs-and-maintenance /services/solar-panel-maintenance-darwin/

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
