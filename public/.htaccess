<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  Redirect 301 /residential-solar-system /solar-systems/residential-solar-system
  Redirect 301 /residential-solar-system/ /solar-systems/residential-solar-system
  Redirect 301 /services/residential-solar-system /solar-systems/residential-solar-system
  Redirect 301 /services/residential-solar-system/ /solar-systems/residential-solar-system
  Redirect 301 /services/commercial-solar-system /solar-systems/commercial-solar-system
  Redirect 301 /services/commercial-solar-system/ /solar-systems/commercial-solar-system
  Redirect 301 /commercial-solar-system /solar-systems/commercial-solar-system
  Redirect 301 /commercial-solar-system/ /solar-systems/commercial-solar-system
  Redirect 301 /services/off-grid-solar-system /solar-systems/off-grid-solar-system
  Redirect 301 /services/off-grid-solar-system/ /solar-systems/off-grid-solar-system
  Redirect 301 /off-grid-solar-system /solar-systems/off-grid-solar-system
  Redirect 301 /off-grid-solar-system/ /solar-systems/off-grid-solar-system
  Redirect 301 /services/solar-panel/ /solar-panels-darwin/
  Redirect 301 /services/solar-panel /solar-panels-darwin/
  Redirect 301 /services/repairs-and-maintenance/ /solar-panels-darwin/
  Redirect 301 /services/repairs-and-maintenance /solar-panels-darwin/
  Redirect 301 /repairs-and-maintenance /solar-panels-darwin/
  Redirect 301 /repairs-and-maintenance/ /solar-panels-darwin/
  Redirect 301 /solar-panel-installation-darwin /services/solar-panel-installation
  Redirect 301 /solar-panel-installation-darwin/ /services/solar-panel-installation
  Redirect 301 /solar-panel-installation /services/solar-panel-installation
  Redirect 301 /solar-panel-installation/ /services/solar-panel-installation
  Redirect 301 /solar-inverters /products/solar-inverters
  Redirect 301 /solar-inverters/ /products/solar-inverters
  Redirect 301 /services/battery-storage /products/solar-battery-brands/
  Redirect 301 /services/battery-storage/ /products/solar-battery-brands/
  Redirect 301 /battery-storage /products/solar-battery-brands/
  Redirect 301 /battery-storage/ /products/solar-battery-brands/
  Redirect 301 /solar-battery /products/solar-battery-brands/
  Redirect 301 /solar-battery/ /products/solar-battery-brands/
  Redirect 301 /solar-battery-storage /products/solar-battery-brands/
  Redirect 301 /solar-battery-storage/ /products/solar-battery-brands/
  Redirect 301 /services/ev-chargers /services/ev-chargers/installation
  Redirect 301 /services/ev-chargers/ /services/ev-chargers/installation
  Redirect 301 /ev-charger /services/ev-chargers/installation
  Redirect 301 /ev-charger/ /services/ev-chargers/installation
  Redirect 301 /ev-chargers /services/ev-chargers/installation
  Redirect 301 /ev-chargers/ /services/ev-chargers/installation
  Redirect 301 /blog /blogs
  Redirect 301 /blog/ /blogs
  Redirect 301 /alice-springs /solar-alice-springs/
  Redirect 301 /alice-springs/ /solar-alice-springs/
  Redirect 301 /solar-power-alice-springs-nt /solar-alice-springs/
  Redirect 301 /solar-power-alice-springs-nt/ /solar-alice-springs/

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
